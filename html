#include <stdio.h>

#define MAX 20

int main(void)
{
    int a[MAX], b[MAX], n, i, j, temp, key;

    printf("Enter number of elements (1-%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid number of elements.\n");
        return 1;
    }

    printf("Enter the elements:\n");
    for (i = 0; i < n; i++) {
        if (scanf("%d", &a[i]) != 1) {
            printf("Invalid input.\n");
            return 1;
        }
        b[i] = a[i]; /* Copy array for insertion sort */
    }

    printf("\nBubble Sort Stepwise Process:\n");
    for (i = 0; i < n - 1; i++) {
        for (j = 0; j < n - i - 1; j++) {
            if (a[j] > a[j + 1]) {
                temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
        }
        printf("Pass %d: ", i + 1);
        for (j = 0; j < n; j++)
            printf("%d ", a[j]);
        printf("\n");
    }

    printf("\nInsertion Sort Stepwise Process:\n");
    for (i = 1; i < n; i++) {
        key = b[i];
        j = i - 1;
        while (j >= 0 && b[j] > key) {
            b[j + 1] = b[j];
            j--;
        }
        b[j + 1] = key;

        printf("Pass %d: ", i);
        for (j = 0; j < n; j++)
            printf("%d ", b[j]);
        printf("\n");
    }

    return 0;
}
